# Copy this file to .env and adjust values for your environment

# Core
MONGO_URL=mongodb://localhost:27017/cafesmart
# Post-quantum JWT (MLDSA87) seed: exactly 32 bytes, or 64 hex characters.
# Example below is 32 ASCII bytes — replace in production.
MLDSA_SEED=0123456789abcdef0123456789abcdef
# HMAC_SECRET is accepted only as a temporary fallback with the same 32-byte rule.
ADMIN_USERNAMES=admin@example.com
# Production CORS (required when ENVIRONMENT=production). Example: https://app.example.com
# CORS_ALLOWED_ORIGIN=https://app.example.com

# Use in-memory store (no Mongo) for development/testing
# Valid truthy values: true, 1, yes (case-insensitive)
USE_TEST_STORE=false

# Ports (HTTP + ConnectionManagerKit WebSocket)
# HTTP_PORT=8080
WS_HOST=0.0.0.0
WS_PORT=8081

# TLS — required when ENVIRONMENT=production (HTTP + WebSocket share these certs).
# Optional in development: set both to enable https:// and wss:// locally.
# Paths may be absolute or relative to the process working directory.
# Dev: ./scripts/gen-dev-certs.sh → certs/fullchain.pem + certs/privkey.pem
# Prod: mount Let's Encrypt (or your CA) full chain + private key.
# API_LOCAL_FULL_CHAIN=certs/fullchain.pem
# API_LOCAL_PRIV_KEY=certs/privkey.pem

# Metrics (optional)
CAFE_METRICS_COLLECTION=cafe_metrics
CAFE_METRICS_FLUSH_SECONDS=43200
CAFE_METRICS_MAX_BATCH=512
CAFE_METRICS_MAX_WRITE_BYTES=10000000
CAFE_METRICS_MAX_WRITE_COUNT=1000

# Demo café seed + client demo UI (DEBUG builds only — ignored in Release).
# When true in a DEBUG API: auto-seeds empty Mongo, GET /api/auth/runtime returns demoMode=true
# (client shows “Load demo café data”), and admin POST /api/auth/debug/seed is available.
# Release API always reports demoMode=false and ignores this flag.
SEED_TEST_DATA=false
# Realistic neighborhood-café defaults (~40–80 tickets/day over 90 days)
DUMMY_DAYS_BACK=90
DUMMY_BASE_ORDERS_MIN=2
DUMMY_BASE_ORDERS_MAX=5
DUMMY_MAX_ITEMS_PER_ORDER=3
# DEBUG admin: POST /api/auth/debug/seed (empty only) or /debug/reseed (wipe + reload)

# ML / trainer (server-side Python → ONNX)
# TRAINER_PYTHON defaults to python3; Docker/local bootstrap may point at Trainer/.venv/bin/python
# TRAINER_PYTHON=python3
# TRAINER_SCRIPT=Trainer/train_restock.py
# Keep at most N artifacts per (kind, runtime); active is always retained
MODEL_RETENTION_COUNT=5
# Monthly auto-train (all server-train kinds). Day clamped 1–28; hour is UTC.
# AUTO_TRAIN_ENABLED=true
# AUTO_TRAIN_DAY=1
# AUTO_TRAIN_HOUR_UTC=10
# ONNX Runtime dynamic library search path (local Mac/Linux; Docker images set this)
# DYLD_LIBRARY_PATH=Vendor/swift-onnx-runtime/Sources/CONNX/lib
# LD_LIBRARY_PATH=Vendor/swift-onnx-runtime/Sources/CONNX/lib

# Example log level for docker-compose (if you wire it up)
LOG_LEVEL=debug

# Prepaid / Stripe (ops kill switch). Merchant must also set BusinessConfig.prepaidPaymentsEnabled.
# All of: PAYMENTS_ENABLED + secret + publishable + webhook secret → prepaidAvailable.
# PAYMENTS_ENABLED=1
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_PUBLISHABLE_KEY=pk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_CURRENCY=usd
# STRIPE_MERCHANT_COUNTRY=US
# Must match skip-stripe / stripe-ios ephemeral key API version (default 2020-08-27):
# STRIPE_EPHEMERAL_KEY_API_VERSION=2020-08-27
# Webhook endpoint: POST /api/webhooks/stripe (events: payment_intent.succeeded)

# Stripe Tax (default on when payments enabled). Enable Tax + registrations in Dashboard first.
# STRIPE_TAX_ENABLED=1
# STRIPE_TAX_CODE=txcd_40060003
# Café / pickup address used for tax location (recommended for in-store pickup):
# STRIPE_TAX_ADDRESS_LINE1=123 Main St
# STRIPE_TAX_ADDRESS_CITY=Seattle
# STRIPE_TAX_ADDRESS_STATE=WA
# STRIPE_TAX_ADDRESS_POSTAL_CODE=98101
# STRIPE_TAX_ADDRESS_COUNTRY=US

# Catalog media (Cloudflare R2) — required when ENVIRONMENT=production
# Local/testing uses FakeMediaStorage or LocalMediaStorage when R2 is unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT=
# R2_REGION=auto
# MEDIA_ALLOWED_HOSTS=media.example.com
# MEDIA_MAX_UPLOAD_BYTES=5242880
# MEDIA_MAX_PIXELS=20000000
# MEDIA_CACHE_MAX_AGE_SECONDS=3600

